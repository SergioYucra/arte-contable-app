# Plantilla para el .env del SERVIDOR (Hostinger). P2 (H10): no copiar .env.example, que es para desarrollo.
# Después de completar el .env, corre `php artisan security:check`: debe terminar sin FALLA.
# La app se niega a arrancar en producción con APP_DEBUG=true o con MAIL_MAILER=log/array.

APP_NAME="El Arte de la Contabilidad"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Dominio real con https://: también fija los hosts que acepta la app (trustHosts).
APP_URL=https://tu-dominio.com
# No cambiar la zona una vez que hay datos (las filas viejas quedan corridas).
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# El usuario de la base de datos NO debe tener privilegio DROP (en MySQL, TRUNCATE no dispara triggers).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sesión (P3): cifrada, solo por HTTPS, y redirección forzada de http:// a https://.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
FORCE_HTTPS=true
# Proxies de confianza (P14): vacío si Hostinger sirve la app directo. Con Cloudflare u otro CDN delante,
# lista aquí sus rangos de IP (separados por coma); si no, la redirección a HTTPS puede entrar en bucle.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Correo real (SMTP de Hostinger u otro proveedor). Nunca log ni array en producción.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Core Security ---
PERMISSION_CACHE_STORE=default
# Triggers que impiden borrar la bitácora (S4). En Hostinger normalmente false (ver nota del PR #1).
ACTIVITY_LOG_DB_TRIGGERS=false
# Captcha (P5): claves REALES del panel de Cloudflare Turnstile para este dominio.
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PWNED_PASSWORDS_FAIL_CLOSED=true
# Backups (P6): sumar un disco remoto (por ejemplo "backups,s3" con las variables AWS_*) para que un
# backup sobreviva a la pérdida del servidor. Necesita el cron: * * * * * php /ruta/a/artisan schedule:run
BACKUP_DISKS=backups
BACKUP_NOTIFICATION_EMAIL=
# Clave del zip del backup (contiene la base de datos completa). Guardarla en un gestor de contraseñas.
BACKUP_ARCHIVE_PASSWORD=

# SuperAdmin inicial (CoreSecuritySeeder): un correo real del responsable, nunca el de ejemplo.
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
