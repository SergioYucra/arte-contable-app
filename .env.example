APP_NAME="El Arte de la Contabilidad"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Core Security ---
# Store de cache para permisos ("default" usa CACHE_STORE; en Hostinger: file o database)
PERMISSION_CACHE_STORE=default
# SuperAdmin inicial (CoreSecuritySeeder). Si SUPERADMIN_PASSWORD queda vacio se genera una aleatoria.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=

# --- Calculadoras RC-IVA y Bono de antigüedad (revisión diaria contra boliviaimpuestos.com) ---
# Desarrollador líder que recibe el aviso si cambian sus fórmulas (varios separados por coma; vacío = solo log).
CALCULATORS_ALERT_EMAIL=
# Hora de Bolivia de la revisión (necesita el cron de "php artisan schedule:run").
CALCULATORS_CHECK_AT=07:15
CALCULATORS_CHECK_ENABLED=true
# Huellas de sus páginas (opcional): solo si cambian textos sin tocar la fórmula; ver docs/calculadoras-rciva-bono.
# CALCULATORS_RC_IVA_FINGERPRINT=
# CALCULATORS_BONO_FINGERPRINT=

# --- Protección de los libros ---
# Páginas nuevas que cada persona puede leer por día (volver a una página ya vista no cuenta).
# Después de cambiarlo en el servidor: php artisan config:clear
LIBRARY_DAILY_PAGE_LIMIT=1000

# --- Acceso con Google (OAuth 2.0) ---
# En Google Cloud Console agrega la URI autorizada: {APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: si queda vacío, se usa automáticamente la ruta auth.google.callback ({APP_URL}/auth/google/callback)
GOOGLE_REDIRECT_URI=
